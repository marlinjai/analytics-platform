{
  "name": "@marlinjai/analytics-tracker",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.4.1",
  "description": "Lightweight browser analytics tracker — pageviews, clicks, heatmaps, session replay",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "bundle-check": "bash ../../scripts/check-bundle-size.sh"
  },
  "dependencies": {},
  "peerDependencies": {
    "rrweb": "^2.0.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "rrweb": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.7.3"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marlinjai/analytics-platform.git",
    "directory": "packages/tracker"
  }
}
